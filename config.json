{
  "camera": {
    "device_id": 1,
    "width": 640,
    "height": 480,
    "fps": 30,
    "flip_horizontal": false,
    "source_mirrored": false,
    "backend": "auto",
    "rotate_180": false,
    "hfov_deg": 70.0,
    "facing_distance": 0.8,
    "stall_timeout": 2.0,
    "reconnect_timeout": 30.0
  },
  "tracking": {
    "max_hands": 2,
    "detection_confidence": 0.7,
    "tracking_confidence": 0.5,
    "model_complexity": 1,
    "view_mode": "pov",
    "palm_facing": "mode",
    "swap_hands": false,
    "depth_source": "mediapipe",
    "depth_assist": {
      "max_rate_hz": 10.0,
      "max_age": 0.5,
      "match_radius": 0.12,
      "scale": 1.0
    },
    "identity": {
      "continuity_radius": 0.15,
      "memory_seconds": 0.4,
      "switch_frames": 6,
      "duplicate_radius": 0.05,
      "order_weight": 1.5
    }
  },
  "process": {
    "priority": "above_normal",
    "disable_power_throttling": true
  },
  "network": {
    "host": "127.0.0.1",
    "port": 65432
  },
  "gestures": {
    "pinch_threshold": 0.05,
    "finger_extended_threshold": 0.6
  },
  "calibration": {
    "scale": 1.0,
    "hand_scale": 1.0,
    "filter": {
      "mode": "one_euro",
      "position": { "min_cutoff": 1.0, "beta": 1.5 },
      "depth": { "min_cutoff": 0.3, "beta": 2.0 },
      "rotation": { "min_cutoff": 1.0, "beta": 0.5 },
      "d_cutoff": 1.0,
      "ema": { "position": 0.7, "depth": 0.35, "rotation": 0.5 }
    },
    "pov": {
      "position_offset": [0.0, 0.0, 0.0],
      "camera_rotation_deg": [0.0, 0.0, 0.0],
      "rotation_offset_deg": {
        "left": [0.0, 0.0, -127.0],
        "right": [0.0, 0.0, 127.0]
      }
    },
    "facing": {
      "position_offset": [0.0, 0.0, 0.0],
      "camera_rotation_deg": [0.0, 0.0, 0.0],
      "rotation_offset_deg": {
        "left": [0.0, 0.0, 0.0],
        "right": [0.0, 0.0, 0.0]
      }
    }
  },
  "debug": {
    "show_video": true,
    "show_landmarks": true,
    "show_fps": true,
    "log_gestures": false
  }
}
